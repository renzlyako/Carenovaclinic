# Copy this file to ".env.local" and fill in the real values from Supabase
# (Project Settings -> API Keys)

# SAFE for the browser (public)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# SERVER ONLY! Never prefix with NEXT_PUBLIC_ and never commit to Git.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# For scripts/backup.sh and restore.sh (pg_dump / psql)
SUPABASE_DB_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-ref.supabase.co:5432/postgres